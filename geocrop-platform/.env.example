# core
APP_ENV=dev
JWT_SECRET=change-me
AUTH_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# database
DATABASE_URL=postgresql+psycopg://geocrop:geocrop@postgres:5432/geocrop

# jobs
REDIS_URL=redis://redis:6379/0
CELERY_ALWAYS_EAGER=false

# storage (STORAGE_BACKEND: s3 or local)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=geocrop
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
LOCAL_STORE_DIR=/data/store

# tiles
TILES_INTERNAL_URL=http://tiles:8001
PUBLIC_TILE_BASE=http://localhost:8080/tiles
PUBLIC_PMTILES_BASE=http://localhost:9000/geocrop

# basemap (web). VITE_BASEMAP_MODE: provider or osm_fallback
VITE_API_URL=/api/v1
VITE_AUTH_REQUIRED=false
VITE_BASEMAP_MODE=osm_fallback
VITE_BASEMAP_SAT_STYLE=https://api.maptiler.com/maps/hybrid/style.json
VITE_BASEMAP_STREETS_STYLE=https://api.maptiler.com/maps/streets-v2/style.json
VITE_BASEMAP_KEY=

# models
MODEL_DIRS=/app/model_registry/builtin
MODEL_ARTIFACT_DIR=/data/models
INTERNAL_TOKEN=change-me-internal
MAX_UPLOAD_MB=500
