FROM node:22-alpine AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api/v1
ARG VITE_AUTH_REQUIRED=false
ARG VITE_BASEMAP_MODE=osm_fallback
ARG VITE_BASEMAP_SAT_STYLE=
ARG VITE_BASEMAP_STREETS_STYLE=
ARG VITE_BASEMAP_KEY=
ENV VITE_API_URL=$VITE_API_URL VITE_AUTH_REQUIRED=$VITE_AUTH_REQUIRED VITE_BASEMAP_MODE=$VITE_BASEMAP_MODE \
    VITE_BASEMAP_SAT_STYLE=$VITE_BASEMAP_SAT_STYLE VITE_BASEMAP_STREETS_STYLE=$VITE_BASEMAP_STREETS_STYLE \
    VITE_BASEMAP_KEY=$VITE_BASEMAP_KEY
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
